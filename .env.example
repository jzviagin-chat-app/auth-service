# Copy to .env for local development (`.env` is gitignored). In the cluster these come from k8s.
ENVIRONMENT=dev
LOG_LEVEL=DEBUG
DATABASE_URL=postgresql://auth:auth@localhost:5432/auth
# Separate database that the tests may wipe (created by compose.yaml)
TEST_DATABASE_URL=postgresql://auth:auth@localhost:5432/auth_test
# Rate-limit counters (local Redis from compose.yaml). Tests use db 15 and wipe it.
REDIS_URL=redis://localhost:6379/0
TEST_REDIS_URL=redis://localhost:6379/15
# Any value works locally. The cluster's real one is the Secret "auth-otp".
OTP_PEPPER=dev-only-pepper-not-a-secret
# SMS provider: "fake" (sends nothing) or "globalsms". Each provider's settings use its own prefix.
SMS_PROVIDER=fake
# FAKE_SMS_DAILY_CAP=100
# To try Global SMS locally (real SMS, real money; sender and host are defaults in config.py):
# SMS_PROVIDER=globalsms
# GLOBALSMS_API_KEY=...            (never commit it; in the cluster: sealed Secret "auth-sms")
